# Copy to .env.local and fill in the values.
# See AGENTS.md → "Environment variables" for descriptions.

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>

# --- Photo storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: serve R2 objects from this public base URL instead of signed URLs.
# R2_PUBLIC_URL_BASE=https://cdn.example.com

# --- Google Maps ---
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Bearer tokens for internal endpoints ---
# Required by /api/cron/* (Vercel cron sends this as Authorization: Bearer <value>)
CRON_SECRET=
# Required by /api/health/*
HEALTH_AUTH_TOKEN=

# --- Optional ---
# Override the bundled scraper binary path (defaults to bin/curl-impersonate).
# CURL_IMPERSONATE_BIN=/usr/local/bin/curl-impersonate

# --- Daily change digest (optional) ---
# The nightly cron sends a summary of the last 24h of listing changes to any
# channel configured below. Leave a channel's vars blank to skip it. If nothing
# is configured, no digest is sent.
# Base URL of the app, used to link back to it from the digest.
# APP_BASE_URL=https://www.group-apartment-hunt.xyz
#
# Telegram: create a bot via @BotFather for the token, then get the chat id of
# the user/group the bot should message (e.g. via @userinfobot or getUpdates).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
#
# WhatsApp via Twilio (works with the Twilio WhatsApp Sandbox). Recipients must
# join the sandbox first. TWILIO_WHATSAPP_TO is a comma-separated list of E.164
# numbers; TWILIO_WHATSAPP_FROM is the sandbox (or sender) number, no "whatsapp:".
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_WHATSAPP_TO=+13125550001,+13125550002
